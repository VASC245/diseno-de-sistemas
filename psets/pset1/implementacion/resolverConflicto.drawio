        </mxCell>
        <mxCell id="p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" value="1. El administrador revisa el conflicto reportado (ej: una reserva sobre una cancha deshabilitada)" vertex="1">
          <mxGeometry height="60" width="280" x="320" y="130" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;" value="2. ¿Hay otra cancha apropiada y libre a esa hora?" vertex="1">
          <mxGeometry height="100" width="190" x="365" y="240" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" value="2. El administrador decide reubicar la reserva" vertex="1">
          <mxGeometry height="50" width="200" x="160" y="400" as="geometry" />
        </mxCell>
        <mxCell id="a2a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" value="2a. El administrador decide cancelarla administrativamente, indicando el motivo" vertex="1">
          <mxGeometry height="70" width="220" x="560" y="400" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" value="3. El sistema revisa que la nueva cancha este libre a esa hora" vertex="1">
