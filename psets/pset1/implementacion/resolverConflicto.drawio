  <diagram name="CU-04 Resolver conflicto de reservas" id="cu04">
    <mxGraphModel dx="1286" dy="869" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="920" math="0" shadow="0">
      <root>
