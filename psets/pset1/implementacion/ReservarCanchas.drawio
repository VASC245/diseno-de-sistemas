  <diagram name="CU-04 Resolver conflicto" id="cu04">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cu04-ini" value="inicio" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="430" y="40" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cu04-p1" value="1. El administrador revisa el conflicto (ej: reserva en cancha deshabilitada)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cu04-d2" value="2. ¿Hay otra cancha libre a esa hora?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="370" y="220" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cu04-p2" value="2. Decide reubicar la reserva" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="170" y="360" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cu04-a2a" value="2a. Decide cancelarla administrativamente con un motivo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="560" y="360" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cu04-p3" value="3. El sistema revisa que la nueva cancha este libre" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="170" y="450" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cu04-a2a2" value="El sistema la registra como cancelada por admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="560" y="460" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cu04-p4" value="4. El sistema mueve la reserva" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="170" y="540" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cu04-p5" value="5. El sistema avisa a los afectados y confirma al administrador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="330" y="630" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cu04-fin" value="fin" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="430" y="720" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cu04-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="cu04-ini" target="cu04-p1">
          <mxGeometry relative="1" as="geometry" />
