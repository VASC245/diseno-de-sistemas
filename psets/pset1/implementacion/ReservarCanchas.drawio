          <mxGeometry height="90" width="180" x="370" y="450" as="geometry" />
        </mxCell>
        <mxCell id="cu01-a3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" value="3b. El sistema le pregunta a la regla de prioridad de cada solicitante: antes de las 18:00 gana el equipo oficial, desde las 18:00 gana el orden de llegada. Los demas se rechazan" vertex="1">
          <mxGeometry height="110" width="280" x="630" y="440" as="geometry" />
