          <mxGeometry x="430" y="40" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cu03-d0" value="¿Que quiere hacer el administrador?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cu03-p1" value="1. Pide agregar una cancha con nombre y deporte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="150" y="260" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cu03-a1a" value="1a. Pide deshabilitar una cancha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="620" y="260" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cu03-d2" value="2. ¿Ya existe una cancha con ese nombre?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="160" y="350" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cu03-a2a" value="2a. Se rechaza: nombre repetido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="20" y="490" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cu03-fin2" value="fin" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cu03-p2" value="2. El sistema registra la cancha como activa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="250" y="490" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cu03-p3" value="3. El sistema confirma" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="250" y="580" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cu03-a1a2" value="El sistema la marca como inactiva" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="620" y="350" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cu03-a1a3" value="El sistema busca reservas futuras que quedan en conflicto y le avisa al admin (van a CU-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="600" y="440" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cu03-fin" value="fin" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
