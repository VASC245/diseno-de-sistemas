  <diagram name="CU-01 Reservar cancha" id="cu01">
    <mxGraphModel dx="1222" dy="826" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900" math="0" shadow="0">
      <root>
