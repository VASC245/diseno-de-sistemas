          <mxGeometry x="420" y="40" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cu02-p1" value="1. El estudiante pide cancelar una reserva" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cu02-d2" value="2. ¿La reserva es suya?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="380" y="210" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cu02-a2a" value="2a. Se rechaza: la reserva no le pertenece" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="80" y="225" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cu02-fin2" value="fin" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="140" y="320" width="80" height="40" as="geometry" />
