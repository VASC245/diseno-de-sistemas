        <mxCell id="cu02-p3" value="3. El sistema calcula cuanto falta para el inicio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="360" y="330" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cu02-d4" value="4. ¿Faltan menos de 2 horas?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="380" y="420" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cu02-p4" value="4. Se registra como cancelacion normal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="190" y="550" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cu02-a4a" value="4a. El sistema la registra como no-show (el usuario no decide el resultado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="530" y="550" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cu02-p5" value="5. El sistema avisa el resultado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="360" y="670" width="200" height="50" as="geometry" />
